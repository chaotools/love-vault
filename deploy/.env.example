# Copy to /srv/love-vault/.env, replace every placeholder, then chmod 600 it.
# This file is safe to commit; never commit the real .env file.

# CNB registry image without a tag. The release script writes the immutable tag.
CNB_IMAGE=docker.cnb.cool/chaotools/love-vault

# Use distinct high-entropy random values for each secret.
MOBILE_SERVICE_TOKEN=replace-with-a-random-secret
WEB_SESSION_SECRET=replace-with-a-different-random-secret
VAULT_ENC_KEY=replace-with-a-third-random-secret
BACKUP_PASSPHRASE=replace-with-a-backup-passphrase

# Email reminders (163 SMTP by default). Use the mailbox SMTP authorization code,
# not the normal account password. Recipient addresses are configured in Settings.
SMTP_USER=chaotools2026@163.com
SMTP_PASS=replace-with-163-smtp-authorization-code
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=chaotools2026@163.com

# Public HTTPS origin used for strict browser CSRF checks.
PUBLIC_ORIGIN=https://love.chaotools.tech

# Optional only when the broker is not the default local mini-program backend.
# AUTH_BROKER_URL=http://host.docker.internal:8899/api/love-vault
